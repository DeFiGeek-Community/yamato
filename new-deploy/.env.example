# =============================================================================
# Yamato New Deploy - 環境変数設定
# =============================================================================
# 
# 使用方法:
#   1. このファイルをコピー: cp .env.example .env
#   2. 実際の値を設定: .envファイルを編集
#   3. .envファイルは絶対にコミットしないでください！
#
# =============================================================================

# -----------------------------------------------------------------------------
# ネットワーク設定 (RPC URLs)
# -----------------------------------------------------------------------------

# Sepolia Testnet RPC URL (必須)
# 例: https://sepolia.infura.io/v3/YOUR_PROJECT_ID
#     または https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
SEPOLIA_RPC_URL=

# Mainnet RPC URL (本番環境用、必須)
# 例: https://mainnet.infura.io/v3/YOUR_PROJECT_ID
#     または https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
MAINNET_RPC_URL=

# Localhost RPC URL (オプション)
# Anvilを使用する場合: http://127.0.0.1:8545 (デフォルト)
LOCALHOST_RPC_URL=http://127.0.0.1:8545

# 注意: Chain IDは自動設定されます（設定不要）
#   - Sepolia: 11155111 (自動)
#   - Mainnet: 1 (自動)
#   - Localhost (Anvil): 31337 (自動)

# -----------------------------------------------------------------------------
# 秘密鍵設定
# -----------------------------------------------------------------------------

# デプロイ用の秘密鍵 (必須)
# 0xプレフィックス付きで設定してください
# ローカルテスト用（Anvilのアカウント#0）:
#   0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# マルチシグ署名者の秘密鍵 (本番環境用、オプション)
# ガバナンス受け入れ（accept-governance）時に使用
# ローカル環境では不要（PRIVATE_KEYを使用）
SIGNER_ADDRESS_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Safe (マルチシグ) アドレス設定
# -----------------------------------------------------------------------------

# Sepolia用Safeアドレス (本番環境用、オプション)
# ガバナンス移譲時に使用
SAFE_ADDRESS_SEPOLIA=

# Mainnet用Safeアドレス (本番環境用、オプション)
# ガバナンス移譲時に使用
SAFE_ADDRESS_MAINNET=

# コミュニティマルチシグアドレス (v1.5用、オプション)
# YmtVesting.setAdmin() で使用
COMMUNITY_MULTISIG_ADDRESS=

# -----------------------------------------------------------------------------
# Etherscan設定
# -----------------------------------------------------------------------------

# Etherscan API Key (Etherscan検証用、オプション)
# https://etherscan.io/myapikey で取得
ETHERSCAN_API_KEY=

# -----------------------------------------------------------------------------
# 使用例
# -----------------------------------------------------------------------------
#
# 【ローカルテスト環境】
#   - PRIVATE_KEY: Anvilのデフォルトアカウント#0の秘密鍵
#   - LOCALHOST_RPC_URL: http://127.0.0.1:8545 (デフォルト)
#   - その他の設定: 不要
#
# 【Sepolia Testnet環境】
#   - SEPOLIA_RPC_URL: 必須
#   - PRIVATE_KEY: デプロイ用の秘密鍵
#   - SAFE_ADDRESS_SEPOLIA: ガバナンス移譲時に使用
#   - SIGNER_ADDRESS_PRIVATE_KEY: ガバナンス受け入れ時に使用
#   - ETHERSCAN_API_KEY: Etherscan検証時に使用
#
# 【Mainnet環境】
#   - MAINNET_RPC_URL: 必須
#   - PRIVATE_KEY: デプロイ用の秘密鍵
#   - SAFE_ADDRESS_MAINNET: ガバナンス移譲時に使用
#   - SIGNER_ADDRESS_PRIVATE_KEY: ガバナンス受け入れ時に使用
#   - ETHERSCAN_API_KEY: Etherscan検証時に使用
#   - COMMUNITY_MULTISIG_ADDRESS: v1.5デプロイ時に使用
#
# =============================================================================
