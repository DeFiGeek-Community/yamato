{
  "name": "yamato-new-deploy",
  "version": "1.0.0",
  "description": "Yamato deployment scripts with hardhat-viem",
  "scripts": {
    "compile": "hardhat compile",
    "deploy:v1": "hardhat run scripts/deploy/v1/deploy-all.ts --network localhost",
    "deploy:v1.5": "hardhat run scripts/deploy/v1.5/deploy-all.ts --network localhost",
    "deploy:v2:ymtos": "hardhat run scripts/deploy/v2/deploy-ymtos.ts --network localhost",
    "deploy:v2:cusd": "hardhat run scripts/deploy/v2/deploy-all-cusd.ts --network localhost",
    "deploy:v2:ceur": "hardhat run scripts/deploy/v2/deploy-all-ceur.ts --network localhost",
    "setup:v1": "hardhat run scripts/setup/v1/setup-all.ts --network localhost",
    "setup:v1.5": "hardhat run scripts/setup/v1.5/setup-all.ts --network localhost",
    "setup:v2:cusd": "hardhat run scripts/setup/v2/setup-all-cusd.ts --network localhost",
    "setup:v2:ceur": "hardhat run scripts/setup/v2/setup-all-ceur.ts --network localhost",
    "upgrade:v1.5": "hardhat run scripts/upgrade/v1.5/upgrade-all.ts --network localhost",
    "upgrade:v2:cjpy-currencyos": "hardhat run scripts/upgrade/v2/upgrade-cjpy-currencyos.ts --network localhost",
    "upgrade:v2:score-weight-controller": "hardhat run scripts/upgrade/v2/upgrade-score-weight-controller.ts --network localhost",
    "governance:transfer:v1": "hardhat run scripts/governance/v1-transfer-governance.ts --network localhost",
    "governance:accept:v1": "hardhat run scripts/governance/v1-accept-governance.ts --network localhost",
    "governance:transfer:v1.5": "hardhat run scripts/governance/v1.5-transfer-governance.ts --network localhost",
    "governance:accept:v1.5": "hardhat run scripts/governance/v1.5-accept-governance.ts --network localhost",
    "governance:transfer:v2": "hardhat run scripts/governance/v2-transfer-governance.ts --network localhost",
    "governance:accept:v2": "hardhat run scripts/governance/v2-accept-governance.ts --network localhost"
  },
  "keywords": ["yamato", "defi", "ethereum", "hardhat", "viem"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@safe-global/api-kit": "^2.4.0",
    "@safe-global/protocol-kit": "^4.0.0",
    "@safe-global/safe-core-sdk-types": "^5.0.0",
    "dotenv": "^16.4.5",
    "ethers": "^5.7.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-viem": "^2.0.0",
    "@types/node": "^22.10.1",
    "hardhat": "^2.22.0",
    "typescript": "^5.7.2",
    "viem": "^2.21.53"
  }
}

